;
; OwMemDriver.inf
; OnyxEngine Kernel Memory Driver v2.0
; Architecture: Windows 10 & Windows 11 (x64)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/27/2026,2.0.0.0
CatalogFile = OwMemDriver.cat

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
OwMemDriver.sys = 1,,

[DefaultInstall.NTamd64]
CopyFiles = OwMemDriver.CopyFiles

[OwMemDriver.CopyFiles]
OwMemDriver.sys

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,%SPSVCINST_ASSOCSERVICE%,OwMemDriver.Service

[OwMemDriver.Service]
DisplayName    = %ServiceDisplayName%
Description    = %ServiceDescription%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\OwMemDriver.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName           = "OnyxEngine Project"
DiskName               = "OwMemDriver Installation Disk"
ServiceName            = "OwMemDriver"
ServiceDisplayName     = "OwMemDriver v2.0 Kernel Access Service"
ServiceDescription     = "High-Performance Zero-Attach Physical CR3 Kernel Driver for OnyxEngine"
