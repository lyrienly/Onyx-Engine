;
; OnyxDriver.inf
; OnyxEngine Kernel Driver
; Architecture: Windows 10 & Windows 11 (x64)
;

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderName%
DriverVer   = 10/30/2026,2.0.0.0
CatalogFile = OnyxDriver.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 12

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
OnyxDriver.sys = 1,,

[DefaultInstall.NTamd64]
CopyFiles = OnyxDriver.CopyFiles

[OnyxDriver.CopyFiles]
OnyxDriver.sys

[DefaultInstall.NTamd64.Services]
AddService = %ServiceName%,%SPSVCINST_ASSOCSERVICE%,OnyxDriver.Service

[OnyxDriver.Service]
DisplayName    = %ServiceDisplayName%
Description    = %ServiceDescription%
ServiceType    = 1                  ; SERVICE_KERNEL_DRIVER
StartType      = 3                  ; SERVICE_DEMAND_START
ErrorControl   = 1                  ; SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\OnyxDriver.sys

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderName           = "OnyxEngine Project"
DiskName               = "OnyxDriver Installation Disk"
ServiceName            = "OnyxDriver"
ServiceDisplayName     = "OnyxDriver Ring-0 Kernel Access Service"
ServiceDescription     = "High-Performance Zero-Attach Physical CR3 & EPT Kernel Driver for OnyxEngine"
